{
  "manifest_version": 1,
  "name": "Fakturownia",
  "version": "0.4.0",
  "description": "Two-way sync of clients, and sales invoices issued from Attricat records, between Attricat and Fakturownia (spike).",
  "icons": {
    "48": "assets/icon-48.svg"
  },
  "attricat": {
    "id": "attricat-fakturownia",
    "host_api": ">=1.2.0, <2.0.0"
  },
  "permissions": [
    "attricat.read",
    "attricat.write",
    "events.subscribe",
    "exports.mappings",
    "secrets.read",
    "network.request",
    "storage.extension",
    "configuration.read",
    "logging.write",
    "webhooks.receive",
    "artifacts.read",
    "client.record_header_action",
    "client.explorer_bulk_action",
    "client.operations.start"
  ],
  "host_permissions": [
    {
      "id": "fakturownia-api",
      "matches": [
        "https://*.fakturownia.pl/*"
      ],
      "methods": [
        "GET",
        "POST",
        "PUT"
      ],
      "allow_query": true,
      "timeout_ms": 10000,
      "rate_limit": {
        "requests": 60,
        "per_seconds": 60,
        "burst": 20
      },
      "max_transfer_bytes": 16777216
    }
  ],
  "artifacts": [
    {
      "id": "server",
      "kind": "server_wasm",
      "path": "dist/server.wasm"
    }
  ],
  "configuration": {
    "version": 2,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "clients"
      ],
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,63}$",
          "description": "The Fakturownia account subdomain: <account>.fakturownia.pl."
        },
        "token_secret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Name of the extension secret holding the Fakturownia API token (default fakturownia-api-token)."
        },
        "verify_webhook_token": {
          "type": "boolean",
          "description": "Refuse webhooks whose api_token field does not match the API token (default true)."
        },
        "clients": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blueprint",
            "fields"
          ],
          "properties": {
            "blueprint": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 64,
              "description": "Code of the blueprint whose records are Fakturownia clients. New records use its current published revision."
            },
            "context": {
              "type": "string",
              "maxLength": 64,
              "description": "Code of the context values are read and written in (default default).",
              "minLength": 1
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "attribute"
                ],
                "properties": {
                  "field": {
                    "enum": [
                      "name",
                      "tax_no",
                      "email",
                      "phone",
                      "street",
                      "city",
                      "post_code",
                      "country"
                    ]
                  },
                  "attribute": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "maxLength": 64
                  },
                  "owner": {
                    "enum": [
                      "attricat",
                      "fakturownia",
                      "both"
                    ]
                  }
                }
              }
            }
          }
        },
        "invoices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "buyer",
            "positions"
          ],
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blueprint"
              ],
              "properties": {
                "blueprint": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64,
                  "description": "Code of the blueprint invoices are issued from, such as a sales order."
                },
                "context": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "Code of the context values are read and written in (default default)."
                }
              }
            },
            "buyer": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 64,
              "description": "Relationship on the source to a record of the clients blueprint."
            },
            "header": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "vat",
                    "bill"
                  ],
                  "description": "Fakturownia invoice kind (default vat)."
                },
                "issue_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64,
                  "description": "Date attribute on the source; null lets Fakturownia use today."
                },
                "sell_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64,
                  "description": "Date attribute on the source; null lets Fakturownia use today."
                },
                "oid": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64,
                  "description": "Attribute holding the source's number, sent as the order number; null sends the record ID."
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64,
                  "description": "Attribute sent as the invoice description; null sends none."
                },
                "payment_to_days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 365
                },
                "payment_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64
                },
                "currency": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Z]{3}$"
                }
              }
            },
            "positions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "quantity",
                "price_net",
                "tax"
              ],
              "properties": {
                "lines": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "blueprint",
                    "parent"
                  ],
                  "properties": {
                    "blueprint": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "maxLength": 64,
                      "description": "Code of the line blueprint."
                    },
                    "parent": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "maxLength": 64,
                      "description": "Relationship on a line to its source record."
                    }
                  }
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
                  "maxLength": 259
                },
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
                  "maxLength": 259
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
                  "maxLength": 259
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
                  "maxLength": 259
                },
                "price_net": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
                  "maxLength": 259
                },
                "tax": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "attribute": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,3}$",
                      "maxLength": 259
                    },
                    "default": {
                      "enum": [
                        "23",
                        "8",
                        "5",
                        "0",
                        "zw",
                        "np"
                      ]
                    }
                  }
                }
              }
            },
            "write_back": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "number": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "ksef_number": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "ksef_status": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                },
                "file": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "maxLength": 64
                }
              }
            },
            "link_existing_by_oid": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "server": {
    "event_handlers": [
      {
        "id": "push-clients",
        "event_types": [
          "record.created.v1",
          "record.updated.v1"
        ],
        "handler": "handle-event",
        "debounce_ms": 2000
      },
      {
        "id": "apply-webhooks",
        "event_types": [
          "webhook.received.v1"
        ],
        "handler": "handle-event"
      }
    ],
    "webhooks": [
      {
        "id": "fakturownia",
        "title": "Fakturownia changes (clients and invoices)",
        "max_body_bytes": 262144
      }
    ],
    "operations": [
      {
        "id": "pull",
        "handler": "pull",
        "request_schema": {
          "type": "object",
          "additionalProperties": false
        },
        "max_checkpoint_bytes": 4096
      },
      {
        "id": "issue-invoices",
        "handler": "issue-invoices",
        "request_schema": {
          "type": "object",
          "additionalProperties": false
        },
        "max_checkpoint_bytes": 65536,
        "interactive": {
          "version": 1,
          "max_selection": 50
        }
      }
    ]
  },
  "ui": [
    {
      "id": "issue-invoice",
      "version": 1,
      "kind": "action",
      "outlet": "record_header_action", "view": "detail",
      "title": "Issue invoice in Fakturownia",
      "translations": {
        "pl": {
          "title": "Wystaw fakturę w Fakturowni"
        }
      },
      "invoke": {
        "operation": {
          "id": "issue-invoices",
          "input": {}
        }
      },
      "when": {
        "requires_write": true
      }
    },
    {
      "id": "issue-invoices",
      "version": 1,
      "kind": "action",
      "outlet": "explorer_bulk_action", "view": "table",
      "title": "Issue invoice in Fakturownia",
      "translations": {
        "pl": {
          "title": "Wystaw fakturę w Fakturowni"
        }
      },
      "invoke": {
        "operation": {
          "id": "issue-invoices",
          "input": {}
        }
      },
      "when": {
        "requires_write": true,
        "max_records": 50
      }
    }
  ]
}
